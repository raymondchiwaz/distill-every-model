{
  "name": "@distilleverymodel/distill-every-model",
  "version": "0.3.2",
  "description": "Local-first, consent-based capture of LLM outputs into an open training-data commons",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raymondchiwaz/distill-every-model.git"
  },
  "bin": {
    "dem": "npm/dem.cjs",
    "demd": "npm/demd.cjs"
  },
  "files": [
    "npm/*.cjs",
    "npm/bootstrap.py",
    "pyproject.toml",
    "dem/*.py",
    "dem/adapters/*.py",
    "dem/pipeline/*.py",
    "dem/review.css",
    "dem/review-selection.js",
    "dem/source-logos/*.png",
    "dem/source-logos/*.txt",
    ".agents/skills/dem-contribute/SKILL.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "setup": "npm install --global ."
  }
}
